{
  "name": "reposafe-mcp",
  "version": "0.7.0",
  "description": "Privacy-first read-only MCP and CLI repository audit with bounded Git history checks",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --experimental-strip-types --test tests/scanner.test.mjs tests/detection.test.mjs tests/v04-detection.test.mjs tests/baseline.test.mjs",
    "test:git": "node --test tests/git.test.mjs tests/cli.test.mjs",
    "test:integration": "node --test tests/protocol.test.mjs",
    "test": "npm run test:unit && npm run test:git && npm run test:config && npm run test:integration && npm run test:userflow && npm run test:sarif && npm run test:package && npm run test:structured && npm run test:history-options && npm run test:workflow && npm run test:report-contract && npm run test:precision",
    "check": "npm run typecheck && npm run build && npm test && npm run demo",
    "demo": "node tests/demo.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "config": "node scripts/config.mjs",
    "test:config": "node --test tests/config.test.mjs tests/client-setup.test.mjs",
    "doctor": "node dist/cli.js doctor",
    "init": "node dist/cli.js init",
    "test:userflow": "node --test tests/userflow.test.mjs tests/cli-display.test.mjs",
    "pretest:unit": "npm run build",
    "test:package": "node --test tests/package.test.mjs",
    "test:sarif": "node --test tests/sarif.test.mjs",
    "test:structured": "node --test tests/structured-config.test.mjs",
    "test:history-options": "node --test tests/history-options.test.mjs tests/history-checkpoint.test.mjs",
    "benchmark": "node tests/benchmark.mjs --smoke",
    "benchmark:full": "node tests/benchmark.mjs --full",
    "verify:runtime": "npm run build && node scripts/verify-runtime.mjs",
    "test:workflow": "node --test tests/workflow-policy.test.mjs",
    "test:report-contract": "node --test tests/report-contract.test.mjs",
    "test:precision": "node --test tests/precision.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/client": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "bin": {
    "reposafe": "./dist/cli.js",
    "reposafe-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/config.mjs",
    "scripts/client-setup.mjs",
    "README.md",
    "LICENSE",
    "docs/"
  ]
}
