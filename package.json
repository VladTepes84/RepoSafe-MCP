{
  "name": "reposafe-mcp",
  "version": "0.1.0",
  "description": "Local, read-only repository publication readiness checks over MCP",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/scanner.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "test:integration": "node --test tests/protocol.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "@modelcontextprotocol/client": "^2.3.0"
  }
}
